# ------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------

# Google Maps — browser key (referrer-restricted). VITE_ prefix exposes it to the app.
VITE_GOOGLE_MAPS_API_KEY=

# CARTO basemap tiles for the /reps prospects map. Request one at
# https://carto.com/basemaps/apikey/ — it is issued per domain and arrives by
# email. Leave blank and the map still works, but CARTO stamps
# "API KEY REQUIRED" across every tile.
#
# Baked into the bundle at BUILD time, like the key above: after changing it you
# must `docker compose build frontend`, not just restart the container.
VITE_CARTO_API_KEY=
