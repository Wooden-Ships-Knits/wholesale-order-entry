# Server
PORT=8080
CORS_ORIGIN=https://order.wooden-ships.com

# Salesforce (username + password + security token auth)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login
# 'login' for production, 'test' for a sandbox

# No price book id needed: wholesale price books are resolved per season by
# name ("<season> Wholesale") — see docs/architecture.md §3.2 and
# backend/app/salesforce/mapping.py.
SHIPPING_WINDOW_SHEET_ID=
REGION_REP_TERRITORIES_SHEET_ID=
# Admin reports (/admin -> Reports tab). The Salesforce reports are looked up
# by name, so these must match Report.Name exactly.
DTO_REPORT_NAME=Daily Total Order
DMM_REPORT_NAME=UNPAID DAILY MORNING MEETING
DTO_RECAP_RECIPIENT=Paola
DMM_RECAP_RECIPIENT=Paola
# Sheet behind the DMM report — needs the tabs "WHOLESALE Paid Open Orders"
# and "Email Schedule". Share it with the service account's client_email.
PROBLEM_LIST_REPS_SHEET_ID=
# PostgreSQL (used by docker-compose to provision the db container and to
# compose the in-network DATABASE_URL for the backend)
POSTGRES_USER=woodenships
POSTGRES_PASSWORD=
POSTGRES_DB=woodenships

# For local (non-Docker) development only — inside compose this is overridden:
# DATABASE_URL=postgresql+psycopg://woodenships:<password>@localhost:5432/woodenships

# PDF output directory inside the backend container (Phase 4)
PDF_OUTPUT_DIR=/output/orders

# Encrypts the admin-copy order PDF — the only artefact showing a full card
# number — while it waits for the monitoring team to key it into Salesforce.
# The copy lives in the database (never on disk, never emailed) and is purged
# on Accept/Decline. Generate 32 random bytes, base64:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Leave EMPTY to keep no card copy at all — the number is discarded at submit
# and the monitoring team has no way to retrieve it.
# Rotating this key makes existing copies unreadable (they are short-lived, so
# rotate right after a purge sweep). Never commit a real value.
CARD_ENCRYPTION_KEY=
# Card copies are purged this many days after submit even if the order was
# never accepted or declined. Must be >= SIGNATURE_LINK_DAYS: an order can't be
# accepted until it is signed, and Accept is what keys the card into Salesforce,
# so a link outliving the card copy leaves an acceptable order with no number to
# charge. Both are 30 (2026-08-06).
CARD_RETENTION_DAYS=30
# How long a signing link stays usable. Defaults to 30 in app/config.py; set it
# here only to override.
# SIGNATURE_LINK_DAYS=30

# Nearby-stockist conflict check (GET /api/accounts/nearby).
# Server-side Google key for the Distance Matrix API — NOT the browser key in
# frontend/.env. Create a separate key, IP-restrict it to the VM, and enable
# only the Distance Matrix API. Leave empty to run in straight-line mode.
GOOGLE_MAPS_SERVER_API_KEY=
# Drive-time threshold: neighbors closer than this many minutes = conflict.
CONFLICT_MAX_MINUTES=20
# Only accounts that placed an order in the last N years count as stockists.
CONFLICT_ORDER_YEARS=3

# Email — DEFERRED (2026-07-14 decision: v1 stops at PDF output).
# Kept for the future follow-up phase:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ADMIN_EMAIL=orders@wooden-ships.com
#==============SALESFORCE CONFIGURATION==============

SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
# Email (order copies + admin notice). Gmail / Google Workspace SMTP.
# Blank host/user/pass = mail disabled (app logs a warning, orders still work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wholesale@wooden-ships.com
SMTP_PASS=                       # Google App Password (not the account password)
MAIL_FROM=wholesale@wooden-ships.com   # From address; defaults to SMTP_USER if blank
ADMIN_EMAIL=wholesale@wooden-ships.com # gets a copy of every order

# Inbound reply capture (conflict replies land back via a plus-addressed
# Reply-To). IMAP over SSL to the same wholesale@ mailbox. Blank host/user/pass
# = disabled: the poller no-ops. Use a Google App Password, not the account one.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=wholesale@wooden-ships.com
IMAP_PASS=
IMAP_MAILBOX=INBOX
