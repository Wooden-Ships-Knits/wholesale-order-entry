        <!-- ============================ notes ============================ -->
        <mxCell id="note1" value="&lt;b&gt;Admin freeze while a link is live&lt;/b&gt;&#10;Blocked: Accept / Decline, ship window.&#10;Allowed: account relink (nothing reaches&#10;Salesforce until Accept).&#10;Escape hatch: Cancel link." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="930" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Rep lookup&lt;/b&gt;&#10;Written By → the sheet's Name column,&#10;falling back to the territory's lead rep.&#10;Column D is the address mailed — an&#10;assistant's row carries their boss's." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="1060" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;Card handling (rule 1)&lt;/b&gt;&#10;CVV never stored, logged or printed.&#10;Full number exists only inside the&#10;AES-256-GCM admin PDF in the DB —&#10;never on disk, never emailed.&#10;Purged on Accept/Decline or day 30." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;dashed=1;" vertex="1" parent="1">
